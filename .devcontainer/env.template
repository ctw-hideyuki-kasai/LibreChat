# LibreChat DevContainer Environment Variables Template
# Copy the contents below to create your .env file in the project root
# 
# Usage:
#   1. Copy this file content
#   2. Create .env in project root: touch .env
#   3. Paste and edit the values

# === 基本設定 ===
HOST=0.0.0.0
PORT=3080
NODE_ENV=development

# === データベース ===
# MongoDB (DevContainer内のサービスを使用)
MONGO_URI=mongodb://mongodb:27017/LibreChat

# PostgreSQL (VectorDB - DevContainer内のサービスを使用)
DATABASE_URL=postgresql://myuser:mypassword@vectordb:5432/mydatabase
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# === セキュリティ ===
# 以下の値は開発環境用のデフォルト値です。本番環境では必ず変更してください。
# 生成コマンド: openssl rand -hex 32 (JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY)
# 生成コマンド: openssl rand -hex 16 (CREDS_IV)
JWT_SECRET=dev_jwt_secret_change_in_production_32_chars_min
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_32_chars_min
CREDS_KEY=dev_creds_key_change_in_production_32_chars_min
CREDS_IV=dev_creds_iv_16

# === 検索エンジン ===
# Meilisearch (DevContainer内のサービスを使用)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=5c71cf56d672d009e36070b5bc5e47b743535ae55c818ae3b735bb6ebfb4ba63

# === RAG API ===
# RAG API (DevContainer内のサービスを使用)
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000

# === 認証設定 ===
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# === 開発環境設定 ===
# 開発環境では以下の設定を推奨
NO_INDEX=true
TRUST_PROXY=0
DEBUG=false

# === AI プロバイダー設定（オプション） ===
# 開発環境で使用するAIプロバイダーのAPIキーを設定
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# === AWS Bedrock（オプション） ===
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# === ドメイン設定（開発環境では不要） ===
# DOMAIN_CLIENT=http://localhost:3000
# DOMAIN_SERVER=http://localhost:3080








